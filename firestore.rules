rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Everything you log is private to your Google account.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Read-only summary for the iOS widget. Readable by direct `get` only (no listing),
    // so the unguessable doc id acts as the key. Only the owner can write it.
    match /widgets/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // Write-only inbox for the iOS Shortcut: anyone who knows the secret path can add an
      // entry; only the owner can read or clear them (the app imports them as expenses).
      match /items/{itemId} {
        allow create: if exists(/databases/$(db)/documents/widgets/$(id))
                      && request.resource.data.keys().hasOnly(['amount', 'note', 'tag', 'date', 'with'])
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0 && request.resource.data.amount < 1000000
                      && request.resource.data.note is string && request.resource.data.note.size() <= 80
                      && request.resource.data.tag is string && request.resource.data.date is string
                      && request.resource.data.with is list && request.resource.data.with.size() <= 6;
        allow read, delete: if request.auth != null
                            && get(/databases/$(db)/documents/widgets/$(id)).data.owner == request.auth.uid;
      }
    }
  }
}
