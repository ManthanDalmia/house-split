rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Everything you log is private to your Google account.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Read-only summary for the iOS widget. Readable by direct `get` only (no listing),
    // so the unguessable doc id acts as the key. Only the owner can write it.
    match /widgets/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid
                            && request.resource.data.owner == request.auth.uid;
    }
  }
}
